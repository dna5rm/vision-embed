# deploy/Dockerfile.index — vision-index v1 (SPEC section 3).
# Build context is the REPO ROOT (the package lives in vision_index/, not
# deploy/):  docker build -f deploy/Dockerfile.index .
# Base: python:3.12-slim digest, arm64-resolved at build time (Gate 2/3).
FROM python@sha256:c61cffc3bacb94ed026ff8b45d5114b7693dd0420baca0a1ace0e3d0ce9035fd AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

# Runtime deps. numpy is required (app.py/adapters import it), certifi is the
# CA bundle httpx may consult, pydantic/jsonschema for request/response models.
RUN pip install --no-cache-dir fastapi uvicorn sqlite-vec pyyaml httpx \
    prometheus_client jmespath numpy pydantic jsonschema certifi \
    python-multipart

ENV SSL_CERT_FILE=/etc/vision-index/tls/embed-ca.pem

COPY --chown=65532:65532 vision_index/ /app/vision_index/

WORKDIR /app
USER 65532:65532

# TLS-only listener, 9443; metrics on loopback 9190.
EXPOSE 9443 9190

# Read-only rootfs at runtime (compose sets read_only: true); writable volumes:
# tmpfs /tmp and one rw mount per the SQLite db dir. Bearer files are
# ro-mounted 0400/0600 owned by uid 65532. The embed CA is ro-mounted at
# /etc/vision-index/tls/embed-ca.pem (see SSL_CERT_FILE above) — TLS
# verification is never disabled.
ENTRYPOINT ["python", "-m", "vision_index"]
CMD ["--config", "/etc/vision-index/config.yaml"]
